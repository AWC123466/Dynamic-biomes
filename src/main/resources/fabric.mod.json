{
	"schemaVersion": 1,
	"id": "dynamic-biomes",
	"version": "${version}",
	"name": "Dynamic Biomes",
	"description": "Mod/library that allows biomes to appear depending on surrounding blocks. Default profiles can be disabled in order to use it as a dependency and add your own biome profiles.",
	"authors": [
		"AWC"
	],
	"contact": {
		"github": "https://github.com/AWC123466/Dynamic-biomes"
	},
	"license": "LGPL-3.0-only",
	"icon": "assets/dynamic-biomes/shedevr.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.dynamicbiomes.DynamicBiomes"
		],
		"client": [
			"com.dynamicbiomes.client.DynamicBiomesClient"
		],
		"fabric-datagen": [
			"com.dynamicbiomes.client.datagen.DynamicBiomesDatagen"
		]
	},
	"mixins": [
		"dynamic-biomes.mixins.json",
		{
			"config": "dynamic-biomes.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}